# Copy to your host's environment settings (Vercel: Project Settings > Environment Variables).
# Locally, `npm run dev` reads the same names from the macOS Keychain (service "perp-race"),
# see scripts/secrets.mjs. Every venue is optional: without its key a venue falls back to
# network time only (Hyperliquid and Lighter add their published latency figure).

# Somnia Tokyo mainnet wallet that places the DreamDEX order (a little SOMI for gas and about 10 USDso for margin)
DREAMDEX_KEY=

# Hyperliquid API wallet (agent) private key, approved by your master account
HL_AGENT_KEY=

# Arcus Ed25519 API secret, the account address and subaccount index
ARCUS_API_SECRET=
ARCUS_ADDRESS=
ARCUS_ACCOUNT_INDEX=0

# Lighter API private key, account index and API key index (4-254)
LIGHTER_API_PRIVATE_KEY=
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=

# Aster V3 API wallet private key
ASTER_SIGNER_KEY=

# RISEx: your main account address and the API wallet (session key) private key registered to it
RISEX_ACCOUNT=
RISEX_SIGNER_KEY=
